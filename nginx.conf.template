# 1. Redirect HTTP to HTTPS
server {
    listen 80;
    server_name orthorms.duckdns.org;
    return 301 https://$host$request_uri;
}

# 2. HTTPS Server Configuration
server {
    listen 443 ssl;
    server_name orthorms.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/orthorms.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/orthorms.duckdns.org/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Serve static assets
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy API requests to Backend EC2
    location /api/ {
        proxy_pass http://${BACKEND_PRIVATE_IP}:5000/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache_bypass $http_upgrade;
    }
}
